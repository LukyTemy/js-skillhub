{
  "realm": "COURSES-APP",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": true,
  "ssoSessionIdleTimeout": 1800,
  "accessTokenLifespan": 300,

  "clients": [
    {
      "clientId": "web-app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5002/login-callback",
        "http://localhost:5002/*"
      ],
      "webOrigins": [
        "http://localhost:5002",
        "*"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],

  "roles": {
    "client": {
      "web-app": [
        { "name": "student" },
        { "name": "instructor" },
        { "name": "admin" }
      ]
    }
  },

  "users": [
    {
      "username": "student1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Student",
      "lastName": "One",
      "email": "student1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "student",
          "temporary": false
        }
      ],
      "clientRoles": {
        "web-app": ["student"]
      }
    },
    {
      "username": "instructor1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Instructor",
      "lastName": "One",
      "email": "instructor1@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "instructor",
          "temporary": false
        }
      ],
      "clientRoles": {
        "web-app": ["instructor"]
      }
    }
  ]
}